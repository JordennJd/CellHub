#!/usr/bin/env bash
# Проверяет форматирование и порядок модулей Rust-файлов перед коммитом.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Хук нужен только если в коммит попали Rust-файлы.
if ! git diff --cached --name-only --diff-filter=ACMR -- '*.rs' | grep -q .; then
  exit 0
fi

if ! bash "$repo_root/scripts/rust.sh" fmt --all -- --check; then
  echo "✗ Rust-файлы не отформатированы. Выполните: just fmt (или cargo fmt --all)" >&2
  exit 1
fi

if ! python3 "$repo_root/scripts/module_order.py" "$repo_root"/crates/*/src/lib.rs; then
  echo "✗ Нарушен порядок модулей. Исправьте порядок mod/use в crates/*/src." >&2
  exit 1
fi
