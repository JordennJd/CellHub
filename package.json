{
  "name": "cellhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-rust-frontend.mjs --simulation",
    "build:rust-frontend": "node scripts/build-rust-frontend.mjs",
    "build": "npm run build:wasm && npm run build:rust-frontend && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:rust": "bash scripts/rust.sh test --workspace",
    "preview": "vite preview --host 127.0.0.1",
    "test:wasm": "npm run build:wasm && node --test scripts/simulation.test.mjs",
    "test:server": "bash scripts/rust.sh build -p cellhub-server && node scripts/server.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:model": "node --experimental-strip-types --test scripts/model.test.mjs",
    "test": "npm run test:rust && npm run test:model && npm run test:wasm && npm run test:server"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
