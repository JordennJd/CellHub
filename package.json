{
  "name": "cellhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:rust": "bash scripts/rust.sh test --workspace",
    "preview": "vite preview --host 127.0.0.1",
    "test:wasm": "npm run build:wasm && node --test scripts/simulation.test.mjs",
    "test:model": "node --experimental-strip-types --test scripts/model.test.mjs",
    "test": "npm run test:rust && npm run test:model && npm run test:wasm"
  },
  "dependencies": {
    "pixi.js": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
